{
	"name": "st-to-il-compiler",
	"version": "0.0.1",
	"description": "Compiler that compiles ST source code to proprietary IL",
	"main": "dist/app.js",
	"repository": "https://github.com/SheepCreativeSoftware/ST-to-IL-compiler.git",
	"author": "Marina Egner",
	"license": "MIT",
	"private": true,
	"bin": {
		"st-to-il-compiler": "bin/st-to-il-compiler.js"
	},
	"type": "module",
	"engines": {
		"node": ">=24.20.0"
	},
	"scripts": {
		"clean": "rm -rf dist/",
		"prebuild": "npm run clean",
		"build": "tsc --project tsconfig.node.json",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:eslint": "eslint --cache --cache-strategy content",
		"lint:eslint:fix": "npm run lint:eslint -- --fix",
		"lint:prettier": "prettier --check \"**/*.{xml,json,yml,yaml,css}\"",
		"lint:prettier:fix": "prettier --write \"**/*.{xml,json,yml,yaml,css}\"",
		"lint:tsc": "tsc --project tsconfig.node.json --noEmit",
		"test": "tsx --test 'src/**/*.test.ts'",
		"test:watch": "tsx --test --watch \"**/*.test.ts\"",
		"test:coverage": "tsx --test --experimental-test-coverage \"**/*.test.ts\"",
		"verify": "npm run build && npx st-to-il-compiler verify -f test.st",
		"compile": "npm run build && npx st-to-il-compiler compile -f test.st",
		"deps:check": "ncu --format group --cooldown '7d'",
		"deps:update": "npm run deps:check -- --interactive",
		"prepare": "husky"
	},
	"dependencies": {
		"buntstift": "^5.0.2",
		"command-line-args": "^6.0.2",
		"command-line-usage": "^7.0.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/command-line-args": "^5.2.3",
		"@types/command-line-usage": "^5.0.4",
		"@types/eslint__js": "^9.14.0",
		"@types/node": "^26.6.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}
